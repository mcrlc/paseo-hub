### advanced with worktree (editor.test.ts)
{
  "authored": {
    "name": "answer",
    "enabled": true,
    "on": {
      "slack.mention": {
        "connection": "company",
        "filters": {
          "channels": [
            "engineering"
          ],
          "from_users": [
            "*"
          ]
        }
      }
    },
    "inputs": {
      "urgency": {
        "type": "string",
        "default": "normal"
      }
    },
    "max_runtime": "4h",
    "run": {
      "target": {
        "daemon": "office",
        "cwd": "/workspace",
        "worktree": {
          "mode": "branch-off",
          "newBranch": "hub-work"
        }
      },
      "agent": {
        "provider": "codex",
        "model": "gpt-5.4",
        "mode": "full-access",
        "thinkingOptionId": "xhigh",
