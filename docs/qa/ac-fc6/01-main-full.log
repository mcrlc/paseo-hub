### continuation key + checkout-pr worktree
{
  "authored": {
    "name": "pr-review",
    "enabled": true,
    "on": {
      "github.pull_request_opened": {
        "connection": "getpaseo-github",
        "filters": {
          "repo": "getpaseo/hub",
          "from_users": [
            "boudra"
          ]
        }
      }
    },
    "inputs": {
      "ticket": {
        "type": "string",
        "default": "none"
      }
    },
    "run": {
      "target": {
        "daemon": "reviewer",
        "cwd": "/srv/hub",
        "worktree": {
          "mode": "checkout-pr",
          "prNumber": 42
        }
      },
      "agent": {
        "provider": "claude",
        "model": "claude-opus-5"
      },
      "continuation": {
        "mode": "key",
        "key": "ticket-${{ paseo.inputs.ticket }}"
      },
      "prompt": "Review the pull request.",
      "max_runtime": "2h",
      "idle_timeout": "10m",
      "auto_archive": true
    }
  },
  "environment": {
    "name": "target",
    "kind": "daemon",
    "daemon": "reviewer",
    "cwd": "/srv/hub",
    "worktree": {
      "mode": "checkout-pr",
      "prNumber": 42
    }
  },
  "events": [
    {
      "name": "pr-review",
      "on": "github.pull_request_opened",
      "maxRuntimeMs": 7200000,
      "steps": [
        {
          "id": "run",
          "environment": "target",
          "maxRuntimeMs": 7200000,
          "idleTimeoutMs": 600000,
          "agent": {
            "provider": "claude",
            "model": "claude-opus-5"
          },
          "prompt": [
            {
              "kind": "text",
              "value": "Review the pull request."
            }
          ],
          "allowOutputs": [
            {
              "type": "github.reply",
              "required": false
            }
          ],
          "autoArchive": true,
          "continuation": {
            "mode": "key",
            "key": "ticket-${{ paseo.inputs.ticket }}"
          }
        }
      ],
      "inputs": {
        "ticket": {
          "type": "string",
          "required": false,
          "default": "none"
        }
      },
      "values": {},
      "filters": {
        "repo": "getpaseo/hub",
        "from_users": [
          "boudra"
        ],
        "connection": "getpaseo-github"
      }
    }
  ],
  "authoredHash": "01369ba58004f67e9989a2da01ad0d21292e6e0f25289c5c358c3b23a588a546"
}
